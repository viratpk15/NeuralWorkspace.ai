# Neural Workspace Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
BASE_PATH=/

# Frontend API URL (for Vercel deployment)
# In production, this should point to the Railway backend
# Example: VITE_API_URL=https://nurturing-hope-production-3e49.up.railway.app
VITE_API_URL=

# Database Configuration
# Required - the server will fail to start without this
DATABASE_URL=

# LLM Provider Configuration
# Supported values: "ollama" | "gemini"
# Default: ollama (local development)
# Set to "gemini" to use Google's Gemini API (requires GEMINI_API_KEY)
LLM_PROVIDER=ollama

# Ollama Configuration (used when LLM_PROVIDER=ollama)
# Requires a local Ollama server: https://ollama.com/download
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Google Gemini AI API Key (used when LLM_PROVIDER=gemini)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (reserved for future use)
# GROQ_API_KEY=gsk_your_key_here
