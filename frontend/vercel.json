{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://nurturing-hope-production-3e49.up.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/public/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://nurturing-hope-production-3e49.up.railway.app"
  }
}